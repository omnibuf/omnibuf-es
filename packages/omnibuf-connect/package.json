{
  "name": "@omnibuf/connect",
  "version": "0.1.0",
  "description": "OmniBuf binary codec and unary handlers for @connectrpc/connect",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnibuf/omnibuf-es.git",
    "directory": "packages/omnibuf-connect"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@omnibuf/core": "workspace:*"
  },
  "peerDependencies": {
    "@connectrpc/connect": ">=2.0.0"
  },
  "devDependencies": {
    "@connectrpc/connect": "^2.0.2"
  }
}
